# Every PROVETTE_* setting, with what it is for. Copy to .env (which git ignores) or load it with
# `set -a; . .env; set +a`. The API's settings are described in full at the top of api/settings.py;
# the checker itself (provette check, verify, view) needs none of these.

# The model. Without these the gallery and the checker work and the live flow says it is off.
PROVETTE_API_KEY=            # a Nebius Token Factory key
PROVETTE_BASE_URL=https://api.tokenfactory.nebius.com/v1
PROVETTE_JUDGE_PASSWORD=     # the password in front of the live flow; unset means the flow is off
PROVETTE_DAILY_CAP_USD=2.00  # the day's spend cap for live episodes

# Where a live draft's checks run: local (default), nebius (a Token Factory Sandbox) or docker.
PROVETTE_RUNNER=local
PROVETTE_SANDBOX_PROJECT=    # the Token Factory project id for `nebius`, when IAM cannot name it
PROVETTE_API_DOCS=           # 1 serves the route documentation at /api/docs (the dev server does); off as deployed

# Paths. All default to this checkout; the image and fly.toml set them to /srv and /data.
PROVETTE_DATA_DIR=           # live episodes, the index and the analysis cache (a volume)
PROVETTE_EVAL_DIR=           # eval/
PROVETTE_EPISODES_DIR=       # the pre-run episodes the gallery shows (eval/agent/results)
PROVETTE_GALLERY_SETS=       # which result sets the gallery shows, comma-separated (the four current runs; the earlier runs are on the methods page only)
PROVETTE_CURRENT_SETS=       # which of those are the current run
PROVETTE_PLATEMAPS_DIR=      # eval/platemaps
PROVETTE_REQUESTS_FILE=      # eval/requests/requests.jsonl
PROVETTE_PRICES_FILE=        # eval/prices.json
PROVETTE_DOCS_DIR=           # docs/ (the rulebook and the learning guide the product renders)
PROVETTE_COVERAGE_FILE=      # provette/rules/coverage.yaml
PROVETTE_DECLARED_DIR=       # provette/rules/declared/ (where the rule form saves)
PROVETTE_ROLES_FILE=         # provette/rules/roles.yaml (where a taught word is written)
PROVETTE_SOURCES_FILE=       # provette/rules/sources.yaml
PROVETTE_WEB_DIR=            # the built pages to serve (web/dist)

# The deploy's build, not the API: the public repository's URL, passed to the web build as
# VITE_REPOSITORY by deploy/fly-up.sh and deploy/build.sh; unset, the pages carry no link.
PROVETTE_REPOSITORY_URL=

# Development and tests only.
# PROVETTE_NETWORK=1         lets the tests that talk to Token Factory run (tests/sandbox, tests/planner)
# PROVETTE_REGEN=1           rewrites the rule fixtures' expected findings (tests/rules); read the diff
# PROVETTE_BIG_REPLAY=<path> an analysis JSON for the replay's performance test (web/src/replay)
