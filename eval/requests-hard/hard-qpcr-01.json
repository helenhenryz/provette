{
 "id": "hard-qpcr-01",
 "request": "Set up a qPCR plate for 8 cDNA samples against 3 target genes, each in triplicate, 20 ul reactions: 10 ul of 2x SYBR master mix, 1 ul of the gene's forward primer, 1 ul of its reverse primer, 2 ul of cDNA and 6 ul of water. Include a no-template control in triplicate for each gene, with water in place of cDNA. The master mix, primers and cDNA are in tubes on a cold block.",
 "technique": "qPCR setup",
 "liquids": [
  {
   "name": "sybr",
   "role": "reagent",
   "bind": "name",
   "pattern": "(?i)master\\s*mix|mastermix|\\bmix\\b|sybr"
  },
  {
   "name": "fwd_{i}",
   "role": "sample",
   "bind": "indexed",
   "pattern": "(?i)(?:forward|fwd)\\D{0,12}?(\\d+)",
   "count": 3,
   "index": "number"
  },
  {
   "name": "rev_{i}",
   "role": "sample",
   "bind": "indexed",
   "pattern": "(?i)(?:reverse|rev)\\D{0,12}?(\\d+)",
   "count": 3,
   "index": "number"
  },
  {
   "name": "cdna_{i}",
   "role": "sample",
   "bind": "indexed",
   "pattern": "(?i)(?:cdna|sample|template)\\D{0,12}?(\\d+)",
   "count": 8,
   "index": "number"
  },
  {
   "name": "water",
   "role": "reagent",
   "bind": "name",
   "pattern": "(?i)water|h2o"
  }
 ],
 "destination": {
  "select": "auto"
 },
